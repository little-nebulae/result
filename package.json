{
  "name": "@little-nebulae/result",
  "version": "1.6.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@little-nebulae/error": "1.5.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "type-fest": "6.0.3",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@little-nebulae/error": "^1.0.0",
    "type-fest": "^6.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "warn"
    }
  }
}
